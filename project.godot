; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Mage Game"
run/main_scene="uid://lrwtrhhdv65l"
config/features=PackedStringArray("4.5", "GL Compatibility")
config/icon="uid://csuepx4806tc"

[autoload]

Interface="*res://interface.gd"
EventBus="*res://event_bus.gd"
Global="*res://global.gd"
CameraShake="*res://camera_shake.gd"
NodeShake="*res://node_shake.gd"
NumberPopUp="*res://number_pop_up.gd"
LevelTransition="*res://level_transition.tscn"

[display]

window/stretch/mode="canvas_items"
mouse_cursor/custom_image="uid://bayme6icla0wm"
mouse_cursor/tooltip_position_offset=Vector2(30, -30)

[global_group]

PlayerGroup=""
HealthModuleGroup=""
Main="The root node of the game scene"
YSortedLayerGroup=""
BossHealthBarGroup=""

